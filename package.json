{
  "name": "minerskills",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma institucional da equipe MinerSkills #10019 (FIRST Robotics Competition)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/web",
    "db:stamp": "npm run db:stamp -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:push": "npm run db:push -w apps/api",
    "db:migrate:new": "npm run db:migrate:new -w apps/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "setup": "npm install && npm run db:generate && npm run db:push && npm run db:seed",
    "icons": "node apps/web/scripts/generate-icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,scss,json,md}\"",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "test:e2e": "npm run test -w e2e",
    "test:e2e:headed": "npm run test:headed -w e2e",
    "test:e2e:ui": "npm run test:ui -w e2e"
  },
  "overrides": {
    "qs": "^6.16.0",
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
