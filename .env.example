############################################################
#  MinerSkills #10019 — CONFIGURAÇÃO ÚNICA (raiz do projeto)
#  ------------------------------------------------------
#  Este é o ÚNICO arquivo de configuração da plataforma.
#  Front-end (Vite), back-end (Express), Prisma e Docker
#  leem tudo daqui. Copie para `.env` e ajuste os valores.
#
#  Docs completos: docs/env-reference.md
############################################################

# ─── Geral ────────────────────────────────────────────────
# development | production | test
NODE_ENV=development

# ─── Banco de dados ───────────────────────────────────────
# DATABASE_PROVIDER controla o "provider" carimbado no schema.prisma
# pelo script scripts/stamp-schema.mjs. Valores: sqlite | postgresql
DATABASE_PROVIDER=sqlite
# SQLite (dev): caminho relativo à pasta apps/api/prisma/
DATABASE_URL="file:../data/dev.db"
#
# Para PostgreSQL, troque as DUAS linhas acima por:
#   DATABASE_PROVIDER=postgresql
#   DATABASE_URL="postgresql://minerskills:trocar-em-producao@localhost:5432/minerskills?schema=public"
# (dentro do Docker o host é o serviço "postgres", não "localhost")

# ─── PostgreSQL (docker compose --profile postgres) ───────
POSTGRES_USER=minerskills
POSTGRES_PASSWORD=trocar-em-producao
POSTGRES_DB=minerskills
POSTGRES_PORT=5432

# ─── API (back-end Express) ───────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
# Origem do front-end permitida no CORS
WEB_ORIGIN=http://localhost:5173
# URL pública canônica (sem barra final) usada pela API em sitemap.xml,
# robots.txt e na pré-visualização /og para bots sociais. Em produção, o
# mesmo domínio de VITE_SITE_URL (a versão do front, embutida no bundle).
SITE_URL=http://localhost:5173
# Quantidade de proxies confiáveis à frente da API (hops):
# 0 = nenhum (dev) · 1 = só nginx · 2 = Caddy + nginx (docker-compose.prod.yml)
# Necessário para o rate limit por IP enxergar o IP real do cliente.
TRUST_PROXY=0
# Limite do corpo das requisições JSON
BODY_LIMIT=1mb

# ─── HTTPS e backup (stack de produção: docker-compose.prod.yml) ──
# Domínio público servido pelo Caddy (certificado automático, Let's Encrypt).
# `localhost` gera um certificado interno autoassinado, só para testar o stack.
DOMAIN=localhost
# E-mail da conta ACME (avisos de expiração do certificado). Opcional;
# com DOMAIN=localhost deixe vazio.
ACME_EMAIL=
# Pasta do host que recebe os backups (dump do Postgres + tar dos uploads)
BACKUP_DIR=./backups
# Intervalo entre backups automáticos (horas) e retenção (dias; 0 = não apagar)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# ─── Autenticação (admin) ─────────────────────────────────
# Gere com: openssl rand -hex 32   (mínimo 32 caracteres)
JWT_SECRET=troque-por-uma-chave-secreta-de-no-minimo-32-chars
JWT_EXPIRES_IN=12h
AUTH_COOKIE_NAME=ms_admin
# Usados APENAS pelo seeder para criar o admin inicial
ADMIN_EMAIL=admin@minerskills.com.br
ADMIN_PASSWORD=MinerSkills@10019
ADMIN_NAME=Administrador MinerSkills

# ─── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_FORUM_MAX=10
RATE_LIMIT_QUIZ_MAX=30
# Envios do formulário de contato/inscrição por IP e janela
RATE_LIMIT_CONTACT_MAX=5

# ─── Uploads ──────────────────────────────────────────────
# Diretório (dentro de apps/api) usado como volume no Docker
UPLOADS_DIR=./data/uploads
UPLOAD_IMAGE_MAX_MB=8
UPLOAD_VIDEO_MAX_MB=60
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_ALLOWED_VIDEO_TYPES=video/mp4,video/webm
# Largura (px) dos thumbnails gerados pelo sharp
THUMB_WIDTH=480

# ─── Seeder ───────────────────────────────────────────────
# full | test  (test = dataset pequeno e determinístico p/ e2e)
SEED_MODE=full
# remote (baixa imagens de picsum.photos) | local (placeholders gerados)
SEED_IMAGE_SOURCE=remote

# ─── Front-end (somente variáveis VITE_* chegam ao navegador) ──
VITE_API_URL=/api
VITE_UPLOADS_URL=/uploads
# URL canônica do site (sem barra final): og:url/og:image do index.html,
# canonical e JSON-LD das páginas. Mesmo domínio de SITE_URL.
VITE_SITE_URL=http://localhost:5173
VITE_TEAM_NUMBER=10019
VITE_TEAM_NAME=MinerSkills
# Alvo do proxy do Vite dev-server para /api e /uploads
VITE_DEV_PROXY_TARGET=http://localhost:3001

# ─── E2E (Playwright) ─────────────────────────────────────
# Os testes sobem servidores próprios em portas separadas, para não
# colidirem com o `npm run dev` nem tocarem no banco de desenvolvimento.
E2E_BASE_URL=http://localhost:5273
E2E_API_PORT=3101
E2E_DATABASE_URL="file:../data/e2e.db"
